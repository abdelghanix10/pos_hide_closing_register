<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_saledetails">
            <style>
                body {
                    font-weight: bold;
                    font-family: "Courier New", Courier, monospace;
                    font-size: 13px;
                    margin: 0;
                    padding: 0;
                }
                table {
                    table-layout: fixed;
                    width: 100%;
                    border-collapse: collapse;
                }
                td, th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    white-space: normal;
                    padding: 2px 0;
                }
                .line-sep {
                    border: none;
                    border-top: 1px dashed #000;
                    margin: 6px 0;
                }
                .double-sep {
                    border: none;
                    border-top: 2px solid #000;
                    margin: 6px 0;
                }
            </style>
            <main>
                <t t-foreach="docs" t-as="o">
                    <t t-set="cfg" t-value="o.config_id"/>
                    <t t-set="sd" t-value="o._get_custom_sale_details_data()"/>
                    <t t-set="curr" t-value="sd['currency']"/>

                    <div class="page" style="padding: 5px;">
                        <!-- 1. Company Info -->
                        <div t-if="cfg.sd_show_company_info" style="text-align: center; margin-bottom: 6px;">
                            <div style="font-size: 15px; font-weight: bold;">
                                <t t-out="o.company_id.name"/>
                            </div>
                            <t t-if="o.company_id.street or o.company_id.city">
                                <small>
                                    <t t-out="o.company_id.street or ''"/>
                                    <t t-if="o.company_id.city">, <t t-out="o.company_id.city"/></t>
                                </small><br/>
                            </t>
                            <t t-if="o.company_id.phone">
                                <small>Tel: <t t-out="o.company_id.phone"/></small><br/>
                            </t>
                        </div>

                        <!-- Report Title & Optional Custom Header -->
                        <div style="text-align: center; margin-bottom: 6px; border-top: 2px solid #000; border-bottom: 2px solid #000; padding: 4px 0;">
                            <strong style="font-size: 15px;">
                                <t t-out="cfg.sale_details_custom_title or 'SESSION REPORT'"/>
                            </strong>
                            <t t-if="cfg.sale_details_custom_header">
                                <br/><small><t t-out="cfg.sale_details_custom_header"/></small>
                            </t>
                        </div>

                        <!-- 2. Session Summary -->
                        <div t-if="cfg.sd_show_session_summary" style="margin-bottom: 6px;">
                            <div>POS: <t t-out="cfg.name"/></div>
                            <div>Session: <t t-out="o.name"/></div>
                            <div>Cashier: <t t-out="sd['cashier']"/></div>
                            <div>Opened: <t t-out="sd['opened_at']"/></div>
                            <div>Closed: <t t-out="sd['closed_at']"/></div>
                            <div>Status: <t t-out="o.state"/></div>
                            <div>Orders: <t t-out="sd['order_count']"/> (Items: <t t-out="'{:.0f}'.format(sd['total_items_qty'])"/>)</div>
                        </div>

                        <hr class="line-sep"/>
                        <div style="text-align: center; font-size: 15px; margin: 4px 0;">
                            <strong>TOTAL SALES: <t t-out="'{:.2f}'.format(sd['total_sales'])"/> <t t-out="curr"/></strong>
                        </div>
                        <hr class="line-sep"/>

                        <!-- 3. Cash Control Summary -->
                        <t t-if="cfg.sd_show_cash_control">
                            <div style="margin-bottom: 6px;">
                                <strong>CASH REGISTER SUMMARY</strong>
                                <table>
                                    <tr>
                                        <td style="width: 60%;">Opening Cash:</td>
                                        <td style="width: 40%; text-align: right;"><t t-out="'{:.2f}'.format(sd['opening_cash'])"/> <t t-out="curr"/></td>
                                    </tr>
                                    <tr>
                                        <td>Expected Cash:</td>
                                        <td style="text-align: right;"><t t-out="'{:.2f}'.format(sd['expected_cash'])"/> <t t-out="curr"/></td>
                                    </tr>
                                    <tr>
                                        <td>Counted Cash:</td>
                                        <td style="text-align: right;"><t t-out="'{:.2f}'.format(sd['counted_cash'])"/> <t t-out="curr"/></td>
                                    </tr>
                                    <tr>
                                        <td>Difference:</td>
                                        <td style="text-align: right;"><t t-out="'{:.2f}'.format(sd['cash_diff'])"/> <t t-out="curr"/></td>
                                    </tr>
                                </table>
                            </div>
                            <hr class="line-sep"/>
                        </t>

                        <!-- 4. Sales Breakdown by Category & Product -->
                        <t t-if="cfg.sd_show_sales_by_category">
                            <div style="margin-bottom: 6px;">
                                <strong>SALES BREAKDOWN</strong>
                                <table>
                                    <thead>
                                        <tr style="border-bottom: 1px solid #000;">
                                            <th style="width: 50%; text-align: left;">Item</th>
                                            <th style="width: 15%; text-align: right; padding-right: 6px;">Qty</th>
                                            <th style="width: 35%; text-align: right;">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="sd['categories']" t-as="cat">
                                            <tr style="border-top: 1px solid #000;">
                                                <td style="padding-top: 4px;"><strong>[<t t-out="cat['name']"/>]</strong></td>
                                                <td style="text-align: right; padding-right: 6px; padding-top: 4px;">
                                                    <strong><t t-out="'{:.0f}'.format(cat['qty'])"/></strong>
                                                </td>
                                                <td style="text-align: right; padding-top: 4px;">
                                                    <strong><t t-out="'{:.2f}'.format(cat['amount'])"/> <t t-out="curr"/></strong>
                                                </td>
                                            </tr>
                                            <t t-foreach="cat['products']" t-as="prod">
                                                <tr>
                                                    <td style="padding-left: 8px;"><t t-out="prod['name']"/></td>
                                                    <td style="text-align: right; padding-right: 6px;"><t t-out="'{:.0f}'.format(prod['qty'])"/></td>
                                                    <td style="text-align: right;"><t t-out="'{:.2f}'.format(prod['amount'])"/> <t t-out="curr"/></td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <hr class="line-sep"/>
                        </t>

                        <!-- 5. Discounts, Taxes & Refunds -->
                        <t t-if="cfg.sd_show_discounts_and_refunds">
                            <div style="margin-bottom: 6px;">
                                <strong>TAXES, DISCOUNTS &amp; REFUNDS</strong>
                                <table>
                                    <tr>
                                        <td style="width: 60%;">Net Sales (Excl. Tax):</td>
                                        <td style="width: 40%; text-align: right;"><t t-out="'{:.2f}'.format(sd['net_sales'])"/> <t t-out="curr"/></td>
                                    </tr>
                                    <tr>
                                        <td>Total Taxes:</td>
                                        <td style="text-align: right;"><t t-out="'{:.2f}'.format(sd['total_tax'])"/> <t t-out="curr"/></td>
                                    </tr>
                                    <tr>
                                        <td>Total Discounts:</td>
                                        <td style="text-align: right;"><t t-out="'{:.2f}'.format(sd['total_discount'])"/> <t t-out="curr"/></td>
                                    </tr>
                                    <tr>
                                        <td>Refunds (<t t-out="sd['refund_count']"/>):</td>
                                        <td style="text-align: right;"><t t-out="'{:.2f}'.format(sd['total_refunds'])"/> <t t-out="curr"/></td>
                                    </tr>
                                </table>
                            </div>
                            <hr class="line-sep"/>
                        </t>

                        <!-- 6. Payment Methods -->
                        <t t-if="cfg.sd_show_payment_methods">
                            <div style="margin-bottom: 6px;">
                                <strong>PAYMENTS</strong>
                                <table>
                                    <t t-foreach="sd['payments']" t-as="pm">
                                        <tr>
                                            <td style="width: 60%;"><t t-out="pm['name']"/>:</td>
                                            <td style="width: 40%; text-align: right;"><t t-out="'{:.2f}'.format(pm['amount'])"/> <t t-out="curr"/></td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                            <hr class="line-sep"/>
                        </t>

                        <!-- 7. Closing Inventory Adjustments -->
                        <t t-if="cfg.sd_show_inventory_adjustments and sd['inventory_log']">
                            <div style="margin-bottom: 6px;">
                                <strong>CLOSING INVENTORY CHECK</strong>
                                <table>
                                    <thead>
                                        <tr style="border-bottom: 1px solid #000;">
                                            <th style="width: 50%; text-align: left;">Product</th>
                                            <th style="width: 25%; text-align: right;">Counted</th>
                                            <th style="width: 25%; text-align: right;">Diff</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="sd['inventory_log']" t-as="inv">
                                            <tr>
                                                <td><t t-out="inv['product_name']"/></td>
                                                <td style="text-align: right;"><t t-out="'{:.2f}'.format(inv['counted_qty'])"/></td>
                                                <td style="text-align: right;">
                                                    <t t-out="('{:+.2f}' if inv['difference'] != 0 else '{:.2f}').format(inv['difference'])"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <hr class="line-sep"/>
                        </t>

                        <!-- Final Total & Footer -->
                        <div style="text-align: center; font-size: 15px; margin: 6px 0;">
                            <strong>TOTAL SALES: <t t-out="'{:.2f}'.format(sd['total_sales'])"/> <t t-out="curr"/></strong>
                        </div>
                        <hr class="double-sep"/>
                        <div style="text-align: center; margin-top: 6px;">
                            <t t-if="cfg.sale_details_custom_footer">
                                <strong><t t-out="cfg.sale_details_custom_footer"/></strong><br/>
                            </t>
                            <small>Generated on <t t-out="sd['generated_at']"/></small>
                        </div>
                    </div>
                </t>
            </main>
        </template>

        <record id="sale_details_report" model="ir.actions.report">
            <field name="name">Custom Sales Details</field>
            <field name="model">pos.session</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">pos_hide_closing_register.report_saledetails</field>
            <field name="print_report_name">'Sales Details - %s' % (object.name)</field>
            <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>